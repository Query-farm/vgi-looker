# ------------------------------------------------------------------------ charts

query TTTTT
SELECT chart_kind, id, title, query_id, url FROM looker.main.charts ORDER BY chart_kind, id;
----
look	21	Orders by Status	102	https://acme.cloud.looker.com/looks/21
look	22	Users by Country	103	https://acme.cloud.looker.com/looks/22
look	23	Pivot by day	104	https://acme.cloud.looker.com/looks/23
tile	11	Revenue over time	101	https://acme.cloud.looker.com/dashboards/1
tile	12	About	NULL	https://acme.cloud.looker.com/dashboards/1
tile	13	Orders by status	102	https://acme.cloud.looker.com/dashboards/1
tile	14	Buyers by country	103	https://acme.cloud.looker.com/dashboards/2
tile	15	Revenue (exec)	101	https://acme.cloud.looker.com/dashboards/4

# chart_kind = 'look' never reads the tile search.
statement ok
CREATE TABLE before_tiles AS SELECT count(*) AS n FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/dashboard_elements/search');

query I
SELECT count(*) FROM looker.main.charts WHERE chart_kind = 'look';
----
3

query I
SELECT (SELECT count(*) FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/dashboard_elements/search')) - n FROM before_tiles;
----
0

# The shared BI columns UNION across tools.
query TI
SELECT tool, count(*) FROM (SELECT tool, id, title, folder_path, owner, created_at, updated_at, last_viewed_at, view_count, url FROM looker.main.dashboards UNION ALL SELECT tool, id, title, folder_path, owner, created_at, updated_at, last_viewed_at, view_count, url FROM looker.main.charts) GROUP BY tool;
----
looker	12

# ---------------------------------------------------------------------- queries

query TTTTT
SELECT id, model, explore, fields, filters FROM looker.main.queries WHERE id IN ('101', '102') ORDER BY id;
----
101	thelook	orders	[orders.created_date, orders.count, orders.total_revenue]	[{'field': orders.status, 'value': complete}]
102	thelook	orders	[orders.status, orders.count, orders.is_returned]	[{'field': orders.created_date, 'value': 30 days}, {'field': orders.status, 'value': -cancelled}]

# Without an id filter every query referenced by a tile or Look is read once.
query TI
SELECT string_agg(id, ',' ORDER BY id), count(*) FROM looker.main.queries;
----
101,102,103,104	4

query TT
SELECT pivots, dynamic_fields->>'$[0].table_calculation' FROM looker.main.queries WHERE id = '104';
----
[orders.status]	pct_of_day

query I
SELECT count(*) FROM looker.main.queries WHERE id = '999';
----
0

