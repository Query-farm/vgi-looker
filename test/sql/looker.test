# ------------------------------------------------------------------------ LookML

query TTIT
SELECT name, project_name, explore_count, allowed_connections FROM looker.main.lookml_models ORDER BY name;
----
system__activity	system__activity	1	[]
thelook	thelook	3	[thelook_bq]

query TTTTIII
SELECT explore_name, view_name, sql_table_name, connection_name, join_count, dimension_count, measure_count FROM looker.main.explores WHERE model_name = 'thelook' ORDER BY explore_name;
----
order_facts_internal	order_facts	NULL	thelook_bq	0	0	0
orders	orders	`acme-proj.thelook.orders`	thelook_bq	2	8	3
users	users	acme-proj.thelook.users	thelook_bq	0	2	1

# model_name + explore_name read exactly one explore.
statement ok
CREATE TABLE before_explore AS SELECT count(*) AS n FROM read_json('{LOOKER_FIXTURE_URL}/__requests') WHERE path LIKE '/api/4.0/lookml_models%';

query TT
SELECT field_name, sql_table_name FROM looker.main.explore_fields WHERE model_name = 'thelook' AND explore_name = 'orders' AND category = 'measure' ORDER BY field_name;
----
orders.count	`acme-proj.thelook.orders`
orders.total_revenue	`acme-proj.thelook.orders`
users.count	acme-proj.thelook.users

query I
SELECT (SELECT count(*) FROM read_json('{LOOKER_FIXTURE_URL}/__requests') WHERE path LIKE '/api/4.0/lookml_models%') - n FROM before_explore;
----
1

query TTI
SELECT category, type, count(*) FROM looker.main.explore_fields WHERE model_name = 'thelook' AND explore_name = 'orders' GROUP BY ALL ORDER BY ALL;
----
dimension	date_date	1
dimension	date_time	1
dimension	number	2
dimension	string	3
dimension	yesno	1
filter	date	1
measure	count	1
measure	count_distinct	1
measure	sum	1
parameter	unquoted	1

query TTTTTTT
SELECT view_name, source_view, role, relationship, table_catalog, table_schema, table_name FROM looker.main.explore_tables WHERE model_name = 'thelook' AND explore_name = 'orders' ORDER BY role, view_name;
----
orders	orders	base	NULL	acme-proj	thelook	orders
buyer_facts	user_facts	join	one_to_one	NULL	NULL	NULL
users	users	join	many_to_one	acme-proj	thelook	users

# Lineage: which dashboards read the orders table, through tile queries.
query T
SELECT DISTINCT d.title FROM looker.main.explore_tables t JOIN looker.main.dashboard_elements e ON e.model = t.model_name AND e.explore = t.explore_name JOIN looker.main.dashboards d ON d.id = e.dashboard_id WHERE t.model_name = 'thelook' AND t.table_name = 'orders' AND t.role = 'base' ORDER BY d.title;
----
Exec KPIs
Sales Overview

query I
SELECT count(*) FROM looker.main.explores WHERE model_name = 'nope';
----
0

# ------------------------------------------------- System Activity: content_usage

# Default window: the last 30 days (event 9011, 100 days old, is outside it).
query TTTI
SELECT content_type, content_id, any_value(title), sum(view_count) FROM looker.main.content_usage GROUP BY ALL ORDER BY ALL;
----
dashboard	1	Sales Overview	3
dashboard	2	Marketing Funnel	1
dashboard	4	Exec KPIs	1
look	21	Orders by Status	2

query I
SELECT count(*) FROM looker.main.content_usage WHERE last_view_date <> (SELECT max(view_date) FROM looker.main.content_usage u2 WHERE u2.content_type = content_usage.content_type AND u2.content_id = content_usage.content_id);
----
0

# content_type = 'look' runs only the Look query, filtered to Look-page views.
query I
SELECT sum(view_count) FROM looker.main.content_usage WHERE content_type = 'look';
----
2

query TTTT
SELECT body::JSON->>'model', body::JSON->>'view', body::JSON->'filters'->>'look.id', body::JSON->'filters'->>'history.source' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/queries/run/json') ORDER BY seq DESC LIMIT 1;
----
system__activity	history	NOT NULL	look

# content_id pushes down as an exact list; view_date bounds become the time filter.
query I
SELECT sum(view_count) FROM looker.main.content_usage WHERE content_type = 'dashboard' AND content_id IN ('2', '4') AND view_date >= DATE '2026-01-01' AND view_date <= DATE '2026-12-31';
----
2

query TT
SELECT body::JSON->'filters'->>'dashboard.id', body::JSON->'filters'->>'history.created_time' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/queries/run/json') ORDER BY seq DESC LIMIT 1;
----
2,4	2026-01-01 00:00:00 to 2027-01-01 00:00:00

# A wider explicit window reaches the 100-day-old run of the deleted dashboard.
query I
SELECT sum(view_count) FROM looker.main.content_usage WHERE content_id = '3' AND content_type = 'dashboard' AND view_date >= DATE '2020-01-01';
----
1

# ------------------------------------------------- System Activity: query_history

# Default window: the last 7 days, newest first.
query I
SELECT count(*) FROM looker.main.query_history;
----
9

query TTI
SELECT status, source, count(*) FROM looker.main.query_history WHERE status IN ('error', 'killed') GROUP BY ALL ORDER BY ALL;
----
error	explore	1
error	scheduled_task	1
killed	api4	1

query T
SELECT body::JSON->'filters'->>'history.status' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/queries/run/json') ORDER BY seq DESC LIMIT 1;
----
error,killed

query TRTT
SELECT history_id, runtime_seconds, user_email, message FROM looker.main.query_history WHERE explore = 'orders' AND user_email = 'grace@example.com' AND status = 'error';
----
9004	12.0	grace@example.com	Query exceeded resource limits

query TTT
SELECT body::JSON->'filters'->>'query.view', body::JSON->'filters'->>'user.email', body::JSON->>'query_timezone' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/queries/run/json') ORDER BY seq DESC LIMIT 1;
----
orders	grace@example.com	UTC

# An explicit window becomes the inline query's time filter (one 7-day chunk here).
statement ok
CREATE TABLE before_qh AS SELECT count(*) AS n FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/queries/run/json');

query I
SELECT count(*) FROM looker.main.query_history WHERE created_at >= TIMESTAMPTZ '2026-01-01 00:00:00+00' AND created_at < TIMESTAMPTZ '2026-01-04 00:00:00+00';
----
0

query I
SELECT (SELECT count(*) FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/queries/run/json')) - n FROM before_qh;
----
1

query T
SELECT body::JSON->'filters'->>'history.created_time' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/queries/run/json') ORDER BY seq DESC LIMIT 1;
----
2026-01-01 00:00:00 to 2026-01-04 00:00:00

# A long window is read in growing chunks (7, 14, 28 … days), not one query per day.
query I
SELECT count(*) FROM looker.main.query_history WHERE created_at >= TIMESTAMPTZ '2020-01-01 00:00:00+00' AND created_at < TIMESTAMPTZ '2030-01-01 00:00:00+00' AND source = 'dashboard';
----
6

query T
SELECT typeof(created_at) FROM looker.main.query_history LIMIT 1;
----
TIMESTAMP WITH TIME ZONE

# ----------------------------------------------------------- run_look / run_query

query TIT
SELECT * FROM looker.main.run_look('21') ORDER BY "orders.count" DESC;
----
complete	80	false
shipped	15	false
complete	5	true

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM looker.main.run_look('21')) ORDER BY column_name;
----
orders.count	BIGINT
orders.is_returned	BOOLEAN
orders.status	VARCHAR

query TIR
SELECT * FROM looker.main.run_query('101', row_limit := 2);
----
2026-11-12	42	1234.5
2026-11-11	38	999.25

query TTT
SELECT typeof("orders.created_date"), typeof("orders.count"), typeof("orders.total_revenue") FROM looker.main.run_query('101') LIMIT 1;
----
DATE	BIGINT	DOUBLE

query T
SELECT query::JSON->>'limit' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/queries/101/run/json') ORDER BY seq DESC LIMIT 1;
----
5000

# Pivoted measures and table calculations come back as JSON keyed by pivot value.
query TII
SELECT "orders.created_date", ("orders.count"->>'complete')::INT, ("orders.count"->>'shipped')::INT FROM looker.main.run_query('104');
----
2026-11-12	30	12

query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM looker.main.run_query('104')) ORDER BY column_name;
----
orders.count	JSON
orders.created_date	DATE
pct_of_day	JSON

query I
SELECT "users.count" FROM looker.main.run_query('103') WHERE "users.country" = 'US';
----
12

statement error
SELECT * FROM looker.main.run_query('999');
----
<REGEX>:.*HTTP 404.*

statement error
SELECT * FROM looker.main.run_look('21', row_limit := 0);
----
<REGEX>:.*row_limit.*
