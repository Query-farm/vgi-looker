# name: test/sql/looker.test
# description: SQL tests for the looker worker against the offline Looker API 4.0 replay server (test/mock_api/server.py)
# group: [looker]

require vgi

require-env LOOKER_WORKER

require-env LOOKER_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
ATTACH 'looker' (TYPE vgi, LOCATION '{LOOKER_WORKER}');

# ---------------------------------------------------------------- secret errors

statement error
SELECT count(*) FROM looker.main.dashboards;
----
<REGEX>:.*no looker secret.*

statement ok
CREATE SECRET looker_bad (TYPE looker, BASE_URL '{LOOKER_FIXTURE_URL}', CLIENT_ID 'test-client-id', CLIENT_SECRET 'wrong');

statement error
SELECT count(*) FROM looker.main.dashboards;
----
<REGEX>:.*login failed with HTTP 404.*client_id / client_secret.*

statement ok
DROP SECRET looker_bad;

statement ok
CREATE SECRET looker_insecure (TYPE looker, BASE_URL 'http://acme.cloud.looker.com', CLIENT_ID 'a', CLIENT_SECRET 'b');

statement error
SELECT count(*) FROM looker.main.users;
----
<REGEX>:.*https.*

statement ok
DROP SECRET looker_insecure;

# A trailing /api/4.0 is accepted and dropped; PAGE_SIZE 2 makes every search page.
statement ok
CREATE SECRET looker_fixture (TYPE looker, BASE_URL '{LOOKER_FIXTURE_URL}/api/4.0/', CLIENT_ID 'test-client-id', CLIENT_SECRET 'test-client-secret', WEB_URL 'https://acme.cloud.looker.com', PAGE_SIZE '2');

# ------------------------------------------------------------------- dashboards

query TTTTTIT
SELECT tool, id, title, folder_path, owner, view_count, url FROM looker.main.dashboards ORDER BY id;
----
looker	1	Sales Overview	/Shared/Marketing	Ada Lovelace	120	https://acme.cloud.looker.com/dashboards/1
looker	2	Marketing Funnel	/Shared/Marketing/EMEA	Grace Hopper	45	https://acme.cloud.looker.com/dashboards/2
looker	3	Old Finance	/Shared/Finance	Ada Lovelace	3	https://acme.cloud.looker.com/dashboards/3
looker	4	Exec KPIs	/Shared	Ada Lovelace	300	https://acme.cloud.looker.com/dashboards/4

# 4 dashboards with limit=2: pages at offset 0, 2, 4 (the last one empty).
query T
SELECT list(query::JSON->>'offset' ORDER BY seq) FROM (SELECT * FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/dashboards/search') ORDER BY seq DESC LIMIT 3);
----
[0, 2, 4]

query TTTTT
SELECT created_at, updated_at, last_viewed_at, deleted, readonly FROM looker.main.dashboards WHERE id = '1';
----
2025-01-10 08:00:00+00	2026-10-01 08:00:00+00	2026-11-14 09:30:00+00	false	false

query TTTTT
SELECT f.name, f.title, f.dimension, f.default_value, f.required FROM looker.main.dashboards d, unnest(d.filters) AS t(f) WHERE d.id = '1' ORDER BY f.name;
----
Date	Date	orders.created_date	7 days	false
Status	Order Status	orders.status	complete	true

# Pushdown: folder, owner and deleted become search parameters.
query T
SELECT title FROM looker.main.dashboards WHERE folder_id = '3' AND owner_id = '1' AND NOT deleted;
----
Sales Overview

query TTT
SELECT query::JSON->>'folder_id', query::JSON->>'user_id', query::JSON->>'deleted' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/dashboards/search') ORDER BY seq DESC LIMIT 1;
----
3	1	false

# A prefix becomes a LIKE-style search pattern (Looker matches case-insensitively;
# the SDK re-checks the exact predicate).
query T
SELECT title FROM looker.main.dashboards WHERE title LIKE 'Mark%';
----
Marketing Funnel

query T
SELECT query::JSON->>'title' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/dashboards/search') ORDER BY seq DESC LIMIT 1;
----
Mark%

query I
SELECT count(*) FROM looker.main.dashboards WHERE title = 'sales overview';
----
0

# Strings with search wildcards are not pushed (they would widen the match oddly).
query I
SELECT count(*) FROM looker.main.dashboards WHERE title = 'Old_Finance';
----
0

query T
SELECT query::JSON->>'title' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/dashboards/search') ORDER BY seq DESC LIMIT 1;
----
NULL

