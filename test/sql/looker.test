1

# ------------------------------------------------------- users / groups / roles

query TTTTTT
SELECT id, display_name, email, is_disabled, role_ids, group_ids FROM looker.main.users ORDER BY id;
----
1	Ada Lovelace	ada@example.com	false	[1]	[1, 2]
2	Grace Hopper	grace@example.com	false	[2]	[1]
3	Linus Torvalds	linus@partner.io	true	[2]	[]
4	Svc Bot	NULL	false	[1]	[]

query T
SELECT email FROM looker.main.users WHERE is_disabled;
----
linus@partner.io

query T
SELECT query::JSON->>'is_disabled' FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/users/search') ORDER BY seq DESC LIMIT 1;
----
true

# Credentials are never requested: the fields list names no credentials_* or sessions.
query I
SELECT count(*) FROM read_json('{LOOKER_FIXTURE_URL}/__requests?path=/api/4.0/users/search') WHERE query LIKE '%credentials%' OR query LIKE '%sessions%';
----
0

# The groups search answers 429 (Retry-After: 1) once; the worker waits and retries.
query TIT
SELECT name, user_count, externally_managed FROM looker.main.groups ORDER BY id;
----
Analysts	2	false
Admins (Okta)	1	true
All Users	4	false

# The roles list answers 503 once; the worker backs off and retries.
query TTT
SELECT name, permissions, models FROM looker.main.roles ORDER BY id;
----
Admin	[access_data, administer, see_system_activity, see_looks]	[system__activity, thelook]
Viewer	[access_data, see_looks, see_user_dashboards]	[thelook]

query T
SELECT r.name FROM looker.main.users u, unnest(u.role_ids) AS t(role_id) JOIN looker.main.roles r ON r.id = t.role_id WHERE u.email = 'ada@example.com';
----
Admin

